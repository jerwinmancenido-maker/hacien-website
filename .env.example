# HACIEN Website — Environment Variables
# Copy this file to .env.local for local development
# Set these in Hostinger Node.js dashboard for production

# ── Website Database ─────────────────────────────────────────────
# Hostinger MySQL stores only website-local ecommerce/account data:
# customer signup shell, carts, storefront cache, order intent UI state,
# and manual/sandbox payment records.
# ERP remains on Neon PostgreSQL and is the product/order source of truth.
# Format: mysql://USER:PASSWORD@HOST:3306/DATABASE
DATABASE_URL=

# ── Gateway ──────────────────────────────────────────────────────
# Public website forms submit into the HACIEN API Gateway.
# Local default is http://localhost:4101/api/v1 when unset.
HACIEN_GATEWAY_API_URL=
HACIEN_API_PUBLIC_URL=

# ERP ecommerce API is the source of truth for published catalog and order intents.
# Defaults to HACIEN_API_PUBLIC_URL/HACIEN_GATEWAY_API_URL when unset.
HACIEN_ECOMMERCE_API_URL=

# ── ERP Entry ────────────────────────────────────────────────────
# Public Sign In links point here after ERP is deployed.
# Defaults to https://erp.haciensolutions.com/login when unset.
NEXT_PUBLIC_ERP_URL=

# ── Security ─────────────────────────────────────────────────────
# Strict-Transport-Security is off by default. Enable only after HTTPS is verified.
# Example values only — do not commit real secrets.
HSTS_ENABLE=false
# Integer seconds for max-age (default 300 when unset/invalid/negative)
HSTS_MAX_AGE=300
# Add "; includeSubDomains" only when every covered subdomain is HTTPS-ready
HSTS_INCLUDE_SUBDOMAINS=false
# Add "; preload" only after long max-age + includeSubDomains requirements are met
HSTS_PRELOAD=false
# CSP upgrade-insecure-requests; independent of HSTS_ENABLE (default off)
CSP_UPGRADE_INSECURE_REQUESTS=false

# Cloudflare Turnstile protects public forms and /track lookups.
# TURNSTILE_SITE_KEY is rendered in public form pages.
# TURNSTILE_SECRET_KEY is server-only: Gateway verifies intake tokens, and this
# website uses the same env name for /track Cloudflare siteverify + grant HMAC.
# Example fake values for local docs only — never commit real secrets.
# TURNSTILE_SITE_KEY=1x00000000000000000000AA
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=

# ── BIR registration badge ───────────────────────────────────────
# Build-time env var. The public badge prints "BIR Registered · RSN <value>".
# When unset, the badge shows "BIR Registered" only. Never commit a real RSN.
# The value below is a FAKE placeholder for local docs. CTO sets Jerwin's
# real RSN in the Hostinger build environment.
BIR_RSN=FAKE-RSN-000000

# ── Hostinger Build Safety ───────────────────────────────────────
# Keep Next build worker fan-out below Hostinger process limits.
# Defaults are intentionally conservative for the current production plan.
NEXT_BUILD_CPUS=2
NEXT_STATIC_GENERATION_MAX_CONCURRENCY=2
NEXT_STATIC_GENERATION_MIN_PAGES_PER_WORKER=25

# ── Website chat model ───────────────────────────────────────────
# Server-only. Never prefix with NEXT_PUBLIC_. Leave empty here.
ANTHROPIC_API_KEY=
ANTHROPIC_CHAT_MODEL=
