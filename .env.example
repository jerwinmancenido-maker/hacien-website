# HACIEN Website — Environment Variables
# Copy this file to .env.local for local development
# Set these in Hostinger Node.js dashboard for production

# ── SMTP (REQUIRED for RFQ email delivery) ──────────────────────
# Without these, the server falls back to sendmail at /usr/sbin/sendmail
# which may not exist on Hostinger shared hosting.
# All 6 must be set for SMTP to activate.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SALES_TO_EMAIL=

# ── Security ─────────────────────────────────────────────────────
# Set to "true" to enable HSTS header (recommended in production)
HSTS_ENABLE=true

# Cloudflare Turnstile protects public forms.
# TURNSTILE_SITE_KEY is rendered in public form pages.
# TURNSTILE_SECRET_KEY must remain server-only and must never be logged or committed with a real value.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
